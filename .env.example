# ==============================================================================
# EduSphere LMS - Environment Configuration Template
# NOTE: Do NOT commit real secrets, private keys, or passwords to source control.
# Copy this file to your local development environment as needed.
# ==============================================================================

# Backend API Configuration
ASPNETCORE_ENVIRONMENT=Development
ASPNETCORE_URLS=http://localhost:5005

# SQL Server Connection String
# For Windows LocalDB (default local development):
ConnectionStrings__DefaultConnection=Server=(localdb)\mssqllocaldb;Database=EduSphereDb;Trusted_Connection=True;MultipleActiveResultSets=true;TrustServerCertificate=True
# For Standard SQL Server or Docker:
# ConnectionStrings__DefaultConnection=Server=localhost,1433;Database=EduSphereDb;User Id=sa;Password=YourStrongPasswordHere!;TrustServerCertificate=True

# JWT Token Configuration (Provide a 32+ character random secret in production)
Jwt__Secret=YOUR_RANDOM_SECURE_KEY_AT_LEAST_32_CHARACTERS_LONG!
Jwt__Issuer=EduSphereApi
Jwt__Audience=EduSphereClient
Jwt__ExpirationDays=7

# CORS Configuration
Cors__AllowedOrigins__0=http://localhost:5173
Cors__AllowedOrigins__1=http://localhost:4173

# Frontend (Vite) Environment Configuration
VITE_API_BASE_URL=/api

